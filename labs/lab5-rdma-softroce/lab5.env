# lab5 공통 설정값. vm-up.sh, vm-down.sh, vm-ssh.sh 가 함께 읽음
# 값 하나만 바꾸면 모든 스크립트에 반영됨

# VM 이름
VM_NAMES="rdma1 rdma2"

# VM 사양 (강의장 PC 메모리를 생각해 작게 잡음)
VM_CPUS=2
VM_MEM_MB=2048

# 두 VM 사이 전용 내부 네트워크 이름 (VirtualBox internal network)
# 이 이름이 같은 VM끼리만 통신됨. 호스트 PC와 바깥 네트워크에서는 보이지 않음
INTNET_NAME="aidc-rdma"

# 내부망 주소 대역 (lab1 ~ lab4 의 172.30.30.0/24, 10.0.0.0/24, 10.10.10.0/24 과 겹치지 않게 고름)
# 이 값을 바꾸면 cfg/setup-rxe.sh 의 RDMA_NET_PREFIX 기본값도 같이 바꿔야 함
RDMA_NET="10.50.0"
RDMA_PREFIX=24

# VM 별 값: 이름|내부망 마지막 자리|NAT 랜카드 MAC|내부망 랜카드 MAC|호스트 SSH 포트
VM_SPEC_rdma1="11|0800275A0101|0800275A0111|2251"
VM_SPEC_rdma2="12|0800275A0102|0800275A0112|2252"

# VM 안에서 쓸 사용자 이름
VM_USER="lab"

# 원본 이미지 (Ubuntu 24.04 공식 클라우드 이미지 OVA)
OVA_REL=".cache/images/noble-server-cloudimg-amd64.ova"

# SSH 키 (git 에 올라가지 않는 .cache 아래)
KEY_REL=".cache/lab5-keys/id_ed25519"

# VM 파일을 둘 곳 (git 에 올라가지 않는 .cache 아래)
VMBASE_REL=".cache/vms"
